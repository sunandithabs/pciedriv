#!/bin/sh
mount -t proc none /proc
mount -t sysfs none /sys
mount -t devtmpfs none /dev
mount -t debugfs none /sys/kernel/debug 2>/dev/null
exec >/dev/console 2>&1 </dev/console
echo "== uname: $(uname -r)"
insmod /edu_drv.ko $MODARGS
/test
echo "== stats"; cat /sys/kernel/debug/edu/stats
echo "== dmesg"; dmesg | grep -iE "edu|oops|bug" 
grep -q shell /proc/cmdline && exec sh
poweroff -f
